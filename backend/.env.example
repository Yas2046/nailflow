# Porta da API
PORT=3333

# Conexão com o PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nailflow

# Segredo usado para assinar o JWT (troque em produção por uma string longa e aleatória)
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=7d

# URL do frontend, usada na configuração de CORS
FRONTEND_URL=http://localhost:5173

# ---- Usadas na integração n8n + WhatsApp ----
# URL pública desta API, que o n8n vai chamar (ex.: https://api.seudominio.com)
API_URL=http://localhost:3333

# Credenciais da WhatsApp Business Platform (Meta) — preencher quando integrar
# Como obter: crie um app em https://developers.facebook.com/apps, adicione o
# produto "WhatsApp", pegue o Token temporário/permanente e o Phone Number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Webhook do n8n que a API chama para notificar eventos (confirmação/cancelamento).
# Preencha com a URL do node "Webhook" dos workflows 3 e 5 depois de importá-los no n8n.
# Exemplo: https://seu-n8n.exemplo.com/webhook/nailflow/agendamento-confirmado
N8N_WEBHOOK_URL=
