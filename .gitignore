# ── dependências ──────────────────────────────────────────────────────────────
node_modules/

# ── builds ────────────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# ── variáveis de ambiente ─────────────────────────────────────────────────────
# NÃO comitar nenhum .env real — use os .env.example como referência
.env
.env.local
.env.development
.env.production
.env.staging
# excepção: os arquivos de exemplo são seguros
!.env.example

# ── backups de desenvolvimento ────────────────────────────────────────────────
# Arquivos criados automaticamente durante sessões de dev (.bak_YYYYMMDD-*)
*.bak
*.bak_*

# ── logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── sistema operacional ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── dados locais (docker / n8n / postgres) ────────────────────────────────────
n8n_data/
pgdata/
