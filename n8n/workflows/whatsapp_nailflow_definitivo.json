        -960,
        112
      ],
      "webhookId": "ec52e800-ed54-4a6b-ba1c-54ebe95f7477"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || item;\n\n// Ignorar eventos que não são mensagens\nif (body.event !== 'messages.upsert') return [];\n\nconst data = body.data || {};\nconst key = data.key || {};\nconst message = data.message || {};\n\nconst remoteJid = key.remoteJid || '';\n\n// Ignorar grupos\nif (remoteJid.endsWith('@g.us')) return [];\n\nconst phone = remoteJid.replace('@s.whatsapp.net', '').replace(/\\D/g, '');\nconst fromMe = key.fromMe === true;\nconst waMessageId = key.id || '';\nconst text = (\n  message.conversation ||\n  message.extendedTextMessage?.text ||\n  message.imageMessage?.caption ||\n  ''\n);\n\n// Ignorar mensagens sem texto (audio, sticker, etc.) quando enviadas pelo bot/professional\n// Mas para clientes, ainda podemos querer registrar outros tipos\nconst messageType = data.messageType || 'conversation';\n\n// Ignorar tipos técnicos sem conteúdo real\nconst ignoredTypes = ['protocolMessage','reactionMessage','senderKeyDistributionMessage'];\nif (ignoredTypes.includes(messageType)) return [];\n\n// Se não tem texto e não é fromMe, ignorar (não conseguimos processar áudios, imagens sem legenda)\nif (!text && !fromMe) return [];\n\nconst pushName = data.pushName || '';\nconst instance = body.instance || '';\n\nreturn [{ json: { phone, text, waMessageId, fromMe, pushName, instance, messageType } }];"
      },
      "id": "fd421f29-3bb5-49d6-86b6-625697b5d6f4",
      "name": "Extrair Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        112
      ]
    },
