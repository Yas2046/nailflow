    {
      "parameters": {
        "jsCode": "const servicos = $input.first().json;\nconst pedido = $('Identificar intenção').first().json;\nconst servico = servicos.find(s => s.name === pedido.servico && s.active);\nif (!servico) return [{ json: { ...pedido, erro: 'servico_nao_encontrado' } }];\nreturn [{ json: { ...pedido, serviceId: servico.id, durationMinutes: servico.durationMinutes } }];"
      },
