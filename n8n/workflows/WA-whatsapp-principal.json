      "id": "wa-webhook",
      "name": "Webhook WhatsApp (Meta)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst entry = body.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\n\nif (!message) {\n  return [{ json: { ignore: true } }];\n}\n\nreturn [{\n  json: {\n    from: message.from,\n    text: message.text?.body || '',\n    waMessageId: message.id,\n  }\n}];"
      },
      "id": "extrair-mensagem",
      "name": "Extrair mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [140, 0]
    },
    {
      "parameters": {
        "jsCode": "const text = ($json.text || '').toLowerCase();\n\n// Detectar intenção de consulta de horários\nconst consultaKeywords = ['horário', 'horarios', 'horario', 'disponível', 'disponivel', 'quando tem', 'tem vaga', 'agenda', 'livre', 'que horas', 'quais horas', 'ver horário', 'horários disponíveis'];\nconst isConsulta = consultaKeywords.some(k => text.includes(k));\n\n// Detectar intenção de agendamento (serviço + data + hora)\nconst servicos = {\n  'manicure e pedicure': 'Manicure + Pedicure',\n  'manicure + pedicure': 'Manicure + Pedicure',\n  'pedicure': 'Pedicure',\n  'manicure': 'Manicure',\n  'gel': 'Esmaltação em gel',\n  'alongamento': 'Alongamento',\n};\nlet servico = null;\nfor (const [chave, nome] of Object.entries(servicos)) {\n  if (text.includes(chave)) { servico = nome; break; }\n}\n\nconst spDateStr = d => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(d);\nconst spHoje = spDateStr(new Date());\nlet data = null;\nif (text.includes('amanha') || text.includes('amanhã')) {\n  const [y, m, d] = spHoje.split('-').map(Number);\n  data = spDateStr(new Date(Date.UTC(y, m - 1, d + 1, 12)));\n} else if (text.includes('hoje')) {\n  data = spHoje;\n}\n\nconst horaMatch = text.match(/(\\d{1,2})h(\\d{2})?/);\nlet hora = null;\nif (horaMatch) {\n  const h = horaMatch[1].padStart(2, '0');\n  const m = (horaMatch[2] || '00').padStart(2, '0');\n  hora = `${h}:${m}`;\n}\n\nconst isAgendamento = !!(servico && data && hora);\n\nlet intencao;\nif (isAgendamento) {\n  intencao = 'agendamento';\n} else if (isConsulta) {\n  intencao = 'consulta_horarios';\n} else {\n  intencao = 'nao_entendido';\n}\n\nreturn [{ json: { ...$json, servico, data, hora, intencao } }];"
      },
      "id": "identificar-intencao",
      "name": "Identificar intenção",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{$json.intencao}}",
              "rightValue": "agendamento",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-agendamento",
