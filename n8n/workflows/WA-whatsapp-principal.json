      "id": "consultar-disponibilidade",
      "name": "Consultar disponibilidade (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, -300]
    },
    {
      "parameters": {
        "jsCode": "const slots = $input.first().json;\nconst pedido = $('Resolver serviço').first().json;\nconst horarioPedidoISO = new Date(`${pedido.data}T${pedido.hora}:00-03:00`).toISOString();\nconst disponivel = slots.some(s => new Date(s.start).toISOString() === horarioPedidoISO);\nreturn [{ json: { ...pedido, disponivel } }];"
      },
