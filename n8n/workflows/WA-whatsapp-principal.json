    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nlet texto = 'Horários disponíveis:\\n';\nfor (const dia of (resp.days || [])) {\n  const data = new Date(dia.date + 'T12:00:00Z').toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: '2-digit', timeZone: 'America/Sao_Paulo' });\n  const horas = dia.slots.map(s => new Date(s).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' })).join(', ');\n  texto += `\\n${data}: ${horas}`;\n}\nif (!resp.days || resp.days.length === 0) texto = 'No momento não há horários livres nos próximos dias. Me chama que a gente combina! 💅';\nreturn [{ json: { texto, from: $('Identificar intenção').first().json.from } }];"
      },
