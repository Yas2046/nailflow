        "genericAuthType": "httpHeaderAuth",
        "url": "={{ 'http://127.0.0.1:3333/bot/reminders/' + $json.attemptId + '/result' }}",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', errorCode: $json.errorCode, instance: $json.wa_instance_name }) }}"
      },
      "name": "Informar falha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
