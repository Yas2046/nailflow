              "version": 1
            },
            "conditions": [
              {
                "id": "c1d2e3f4-0003-4a00-9000-0000000000c1",
                "leftValue": "={{$json.skip}}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "false"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        }
      },
      {
