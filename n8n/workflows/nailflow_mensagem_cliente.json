      },
      {
        "id": "7a1f3c20-0002-4a00-9000-000000000002",
        "name": "Montar mensagem",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -480,
          128
        ],
        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\nconst { event, payload } = body;\n\n// Só processa o evento genérico de mensagem à cliente, com payload presente.\nif (event !== 'message.send' || !payload || typeof payload !== 'object') {\n  return [{ json: { skip: true, motivo: 'evento_invalido' } }];\n}\n\n// Telefone da cliente: apenas dígitos, de 10 a 15 (DDI+DDD+número).\nconst telefone = String(payload.clientPhone || '').replace(/\\D/g, '');\nif (telefone.length < 10 || telefone.length > 15) {\n  return [{ json: { skip: true, motivo: 'sem_telefone' } }];\n}\n\n// Instância da profissional dona do agendamento (obrigatória).\nconst instancia = typeof payload.waInstance === 'string' ? payload.waInstance.trim() : '';\nif (!instancia || !/^[A-Za-z0-9_.-]+$/.test(instancia)) {\n  return [{ json: { skip: true, motivo: 'sem_instancia' } }];\n}\n\n// O backend envia o texto pronto em `text`; sem texto não há o que enviar.\nlet texto = typeof payload.text === 'string' ? payload.text.trim() : '';\nif (!texto) {\n  return [{ json: { skip: true, motivo: 'sem_texto' } }];\n}\nif (texto.length > 1000) texto = texto.slice(0, 1000);\n\nreturn [{ json: { telefoneCliente: telefone, waInstance: instancia, texto, skip: false } }];\n"
        }
      },
      {
        "id": "7a1f3c20-0003-4a00-9000-000000000003",
        "name": "IF Enviar?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
